# Core application
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DEMO_SESSION_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-another-long-random-string

# Providers default to their real sandbox. Change only the provider you want
# to demo locally to "simulated"; provider errors never trigger a fake fallback.
PERSONA_MODE=sandbox
PERSONA_API_KEY=persona_sandbox_your-key
PERSONA_TEMPLATE_ID=itmpl_your-template-id
PERSONA_WEBHOOK_SECRET=your-persona-webhook-secret

PLAID_MODE=sandbox
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox

STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

INCREASE_MODE=sandbox
INCREASE_API_KEY=your-increase-sandbox-key
INCREASE_BASE_URL=https://sandbox.increase.com
INCREASE_ACCOUNT_ID=account_your-sandbox-account
INCREASE_WEBHOOK_SECRET=your-increase-webhook-secret
